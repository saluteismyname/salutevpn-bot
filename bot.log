CREATE TABLE users (
	telegram_id BIGINT NOT NULL, 
	username VARCHAR(255), 
	is_active_vpn BOOLEAN NOT NULL, 
	expires_at_vless DATETIME, 
	expires_at_wireguard DATETIME, 
	wg_client_id VARCHAR(255), 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (telegram_id)
)


2026-06-14 20:30:35,262 - sqlalchemy.engine.Engine - INFO - [no key 0.00020s] ()
2026-06-14 20:30:35,304 - sqlalchemy.engine.Engine - INFO - 
CREATE TABLE orders (
	id INTEGER NOT NULL, 
	telegram_id BIGINT NOT NULL, 
	payment_id VARCHAR(255), 
	vpn_type VARCHAR(50) NOT NULL, 
	months INTEGER NOT NULL, 
	amount_value INTEGER NOT NULL, 
	status VARCHAR(50) NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(telegram_id) REFERENCES users (telegram_id) ON DELETE CASCADE, 
	UNIQUE (payment_id)
)


