version: '3.8'

services:
  db:
    image: postgres:15-alpine
    container_name: salute_vpn_db
    restart: always
    environment:
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME}
    volumes:
      # Важно: монтируем папку, чтобы данные сохранялись при перезапуске контейнеров
      - pgdata:/var/lib/postgresql/data
    ports:
      # Доступ к базе будет только с самого сервера (127.0.0.1) для бэкапов. Из интернета войти нельзя.
      - "127.0.0.1:5432:5432"
    networks:
      - vpn_network

  salute_vpn_bot:
    build: .
    container_name: salute_vpn_prod
    restart: always
    ports:
      # Открываем порт только для локального Nginx
      - "127.0.0.1:8080:8080"
    depends_on:
      - db
    env_file:
      - .env
    networks:
      - vpn_network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
  services:
  db:
    # ... твои настройки базы (image, environment, ports) ...
    networks:
      - vpn_network

  adminer:
    image: adminer:latest
    restart: always
    ports:
      - "8080:8080"
    environment:
      ADMINER_DEFAULT_SERVER: db
    networks:
      - vpn_network

# В самый конец файла docker-compose.yml (на одном уровне с services:) добавь:
networks:
  vpn_network:
    driver: bridge
volumes:
  pgdata:

networks:
  vpn_network:
    driver: bridge
